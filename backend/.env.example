APP_ARRIVAL_QR_CLINIC_ID=single-clinic
APP_ARRIVAL_QR_HMAC_SECRET=replace-with-at-least-32-random-bytes
SPRING_PROFILES_ACTIVE=demo
SUPABASE_DB_URL=jdbc:postgresql://127.0.0.1:5432/otcms_auth_patient_local
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=replace-with-local-postgres-password
APP_AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
APP_AUTH_RATE_LIMIT_HMAC_SECRET=replace-with-a-random-secret
APP_AUTH_COOKIE_SECURE=false
APP_DEMO_PASSWORD=replace-with-patient-password-at-least-8-chars
APP_EMAIL_ENABLED=true
APP_EMAIL_HOST=smtp.gmail.com
APP_EMAIL_PORT=587
APP_EMAIL_USERNAME=your-sending-address@gmail.com
APP_EMAIL_PASSWORD=replace-with-google-app-password
APP_EMAIL_FROM=your-sending-address@gmail.com

# Frontend page used in password reset emails (no query string or fragment).
APP_AUTH_PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Supabase Storage S3 API for private diagnostic PDFs; configure credentials only in backend/.env.
# The bucket must already exist, be private, and allow application/pdf up to 25 MB.
APP_DIAGNOSTIC_REPORT_STORAGE_PROVIDER=supabase-storage
APP_DIAGNOSTIC_REPORT_VALIDATION_PROVIDER=clamav-local
APP_DIAGNOSTIC_CLAMAV_HOST=127.0.0.1
APP_DIAGNOSTIC_CLAMAV_PORT=3310
APP_DIAGNOSTIC_CLAMAV_CONNECT_TIMEOUT_MS=1000
APP_DIAGNOSTIC_CLAMAV_READ_TIMEOUT_MS=15000
APP_DIAGNOSTIC_SUPABASE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
APP_DIAGNOSTIC_SUPABASE_S3_REGION=replace-with-project-region
APP_DIAGNOSTIC_SUPABASE_S3_BUCKET=otcms-diagnostic-reports
APP_DIAGNOSTIC_SUPABASE_S3_ACCESS_KEY=replace-with-supabase-storage-s3-access-key
APP_DIAGNOSTIC_SUPABASE_S3_SECRET_KEY=replace-with-supabase-storage-s3-secret-key
