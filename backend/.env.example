# Local Docker PostgreSQL used by docker-compose.final-db.yml and application.yml.
OTCMS_DB_PORT=5433
OTCMS_DB_USERNAME=postgres
OTCMS_DB_PASSWORD=otcms_local
OTCMS_DB_MAX_POOL_SIZE=5
OTCMS_DB_MIN_IDLE=1

# Local authentication/session settings. Replace these values with random secrets of at least 32 bytes.
APP_AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
APP_AUTH_RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-bytes
APP_ARRIVAL_QR_HMAC_SECRET=replace-with-at-least-32-random-bytes
APP_AUTH_COOKIE_SECURE=false
APP_AUTH_COOKIE_SAME_SITE=Strict
APP_AUTH_STAFF_ALLOWED_CIDRS=127.0.0.1/32,::1/128
APP_AUTH_STAFF_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_AUTH_PATIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_AUTH_ACCESS_TOKEN_SECONDS=900
APP_AUTH_REFRESH_TOKEN_SECONDS=604800
APP_AUTH_PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Local project integrations.
APP_ARRIVAL_QR_CLINIC_ID=single-clinic
APP_DIAGNOSTIC_REPORT_STORAGE_PROVIDER=local
APP_DIAGNOSTIC_REPORT_VALIDATION_PROVIDER=clamav-local
APP_DIAGNOSTIC_CLAMAV_HOST=127.0.0.1
APP_DIAGNOSTIC_CLAMAV_PORT=3310
APP_DIAGNOSTIC_CLAMAV_CONNECT_TIMEOUT_MS=1000
APP_DIAGNOSTIC_CLAMAV_READ_TIMEOUT_MS=15000
APP_EMAIL_ENABLED=false
APP_EMAIL_HOST=smtp.gmail.com
APP_EMAIL_PORT=587
APP_EMAIL_USERNAME=
APP_EMAIL_PASSWORD=
APP_EMAIL_FROM=
APP_PAYMENT_PAYOS_ENABLED=false
APP_PAYMENT_PAYOS_CLIENT_ID=
APP_PAYMENT_PAYOS_API_KEY=
APP_PAYMENT_PAYOS_CHECKSUM_KEY=
APPOINTMENT_BOOKING_READINESS_REQUIRED=false
APPOINTMENT_BOOKING_CLINIC_TIME_ZONE=Asia/Ho_Chi_Minh
APPOINTMENT_BOOKING_MAX_HORIZON_DAYS=30
APPOINTMENT_BOOKING_PATIENT_CHANGE_DEADLINE_MINUTES=120
APPOINTMENT_BOOKING_CHECK_IN_EARLY_MINUTES=30
APPOINTMENT_BOOKING_CHECK_IN_LATE_GRACE_MINUTES=15
APPOINTMENT_BOOKING_SLOT_INTERVAL_MINUTES=15
APPOINTMENT_BOOKING_ONLINE_MINIMUM_NOTICE_MINUTES=0
APPOINTMENT_BOOKING_START_LATE_GRACE_MINUTES=15

# Optional local imaging services in Docker.
OTCMS_IMAGING_ENABLED=true
OTCMS_IMAGING_ORTHANC_BASE_URI=http://127.0.0.1:8042
OTCMS_IMAGING_ORTHANC_CONNECT_TIMEOUT=2s
OTCMS_IMAGING_ORTHANC_RESPONSE_TIMEOUT=15s
OTCMS_IMAGING_MAX_UPLOAD_BYTES=52428800
OTCMS_IMAGING_MAX_UPLOAD_FILES=10
OTCMS_IMAGING_MAX_CONCURRENT_UPLOADS=4
OTCMS_IMAGING_ALLOW_UNVALIDATED_DICOM_FOR_TESTING=false
OTCMS_IMAGING_IDENTITY_ALLOW_UNKNOWN_FOR_TESTING=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
APP_DIAGNOSTIC_REPORT_STORAGE_MINIO_ENDPOINT=http://127.0.0.1:9000
APP_DIAGNOSTIC_REPORT_STORAGE_MINIO_REGION=us-east-1
APP_DIAGNOSTIC_REPORT_STORAGE_MINIO_BUCKET=otcms-diagnostic-reports

# Local server limits.
SERVER_TOMCAT_MAX_PART_COUNT=100
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=50MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=100MB

# Optional direct-JDBC test settings for the same local Docker PostgreSQL instance.
OTCMS_TEST_DB_PORT=5433
OTCMS_TEST_DB_NAME=otcms_test_db
OTCMS_TEST_DB_USERNAME=postgres
OTCMS_TEST_DB_PASSWORD=otcms_local

# Object storage for avatars, staff photos, website images, medical documents (local | supabase-storage)
APP_STORAGE_PROVIDER=local
APP_STORAGE_BUCKET=otcms-media
APP_STORAGE_LOCAL_ROOT=./.storage
APP_STORAGE_SUPABASE_S3_ENDPOINT=
APP_STORAGE_SUPABASE_S3_REGION=
APP_STORAGE_SUPABASE_S3_ACCESS_KEY=
APP_STORAGE_SUPABASE_S3_SECRET_KEY=
